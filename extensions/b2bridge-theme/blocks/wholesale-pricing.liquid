  }

  .b2bridge-wholesale-price--pill .b2bridge-wholesale-price__compare,
  .b2bridge-wholesale-price--pill .b2bridge-wholesale-price__discount {
    margin-top: 0;
  }

  .b2bridge-wholesale-price--compact {
    border: 0;
    border-radius: 0;
    margin: 0.35rem 0 0;
    padding: 0;
    background: transparent;
    color: currentColor;
    width: auto;
    box-shadow: none;
    gap: 1px;
    line-height: 1.25;
    max-width: 100%;
  }

  .b2bridge-wholesale-price--compact strong {
    display: block;
    color: var(--b2bridge-price-color, #111827);
    font-size: var(--b2bridge-price-font-size, 13px);
    font-weight: 500;
    line-height: 1.35;
  }

  .b2bridge-wholesale-price--compact .b2bridge-wholesale-price__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .b2bridge-wholesale-price--compact .b2bridge-wholesale-price__compare {
    display: block;
    margin-top: 1px;
    color: rgba(17, 24, 39, 0.58);
    font-size: 11px;
    text-decoration: line-through;
  }

  .b2bridge-wholesale-price--compact .b2bridge-wholesale-price__discount {
    display: inline-block;
    margin-top: 3px;
    padding: 1px 6px;
    font-size: 10px;
  }

  .b2bridge-pricing-debug {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 2147483647;
    max-width: min(360px, calc(100vw - 28px));
    border: 1px solid #f59e0b;
    border-radius: 8px;
    background: #fffbeb;
    color: #78350f;
    padding: 10px 12px;
    font: 12px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    box-shadow: 0 12px 30px rgba(120, 53, 15, 0.16);
