      "type": "checkbox",
      "id": "enable_registration_page_form",
      "label": "Show registration form on page",
      "default": true
    },
    {
      "type": "text",
      "id": "registration_page_handle",
      "label": "Registration page handle",
      "default": "wholesale-registration-form"
    },
    {
      "type": "text",
      "id": "registration_form_id",
      "label": "Registration form ID"
    }
  ]
}
