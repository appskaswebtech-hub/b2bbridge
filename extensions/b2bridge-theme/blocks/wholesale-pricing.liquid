    border-radius: 0;
    margin: 10px 0 14px;
    padding: 0;
    background: transparent;
    color: currentColor;
    display: grid;
    gap: 2px;
    width: fit-content;
    box-shadow: none;
    box-sizing: border-box;
  }

  .b2bridge-cart-pricing-pending .cart-item .price,
  .b2bridge-cart-pricing-pending .cart-item .money,
  .b2bridge-cart-pricing-pending .cart-item__totals,
  .b2bridge-cart-pricing-pending .cart-item__price-wrapper,
  .b2bridge-cart-pricing-pending .cart-drawer .totals__total-value,
  .b2bridge-cart-pricing-pending .cart__footer .totals__total-value {
    visibility: hidden;
  }

  .b2bridge-cart-pricing-pending [data-b2bridge-wholesale-handle] {
    visibility: visible;
  }

  .b2bridge-wholesale-price--product {
    margin: 12px 0 18px;
    width: 100%;
    max-width: 420px;
  }

  .b2bridge-wholesale-price--product.b2bridge-wholesale-price--simple {
    width: auto;
    max-width: none;
  }

  .b2bridge-wholesale-price__label,
  .b2bridge-wholesale-price__compare {
    font-size: 12px;
    color: rgba(17, 24, 39, 0.62);
  }

  .b2bridge-wholesale-price--product .b2bridge-wholesale-price__label,
  .b2bridge-wholesale-price--product .b2bridge-wholesale-price__compare {
    font-size: 12px;
    line-height: 1.35;
  }

  .b2bridge-wholesale-price strong {
